    "# SynBioCrow 2.3 — Computational DBTL Case Study\\n",
    "Reuses persisted benchmark candidates; no retrosynthesis generators are rerun. 1,4-butanediol demonstrates Design → Test → Build-or-abstain. 3-hydroxypropionic acid supplies multiple alternative routes for evidence-aware Learn re-ranking. Missing sequence evidence causes an explicit Build abstention rather than fabricated construct inputs.\\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os,sys,subprocess,shutil,json,zipfile,hashlib,time\nfrom pathlib import Path\nfrom google.colab import drive, files\n\ndrive.mount(\"/content/drive\",force_remount=False)\n\nREPO=Path(\"/content/SynBioCrow_dbtl_case\")\nOUT=Path(\"/content/drive/MyDrive/SynBioCrow/benchmark/2.3/dbtl_case_study\")\nOUT.mkdir(parents=True,exist_ok=True)\n\ndef run(cmd,*,cwd=None,timeout=1800,check=True,stream=False):\n    print(\"$\",\" \".join(map(str,cmd)),flush=True)\n    if stream:\n        p=subprocess.Popen(list(map(str,cmd)),cwd=cwd,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,bufsize=1)\n        t0=time.time(); lines=[]\n        for line in p.stdout:\n            print(line.rstrip(),flush=True); lines.append(line)\n            if time.time()-t0>timeout:\n                p.kill(); raise subprocess.TimeoutExpired(cmd,timeout)\n        rc=p.wait()\n        if check and rc: raise subprocess.CalledProcessError(rc,cmd,output=\"\".join(lines))\n        return rc\n    p=subprocess.run(list(map(str,cmd)),cwd=cwd,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=timeout)\n    print(p.stdout,flush=True)\n    if check and p.returncode: raise subprocess.CalledProcessError(p.returncode,cmd,output=p.stdout)\n    return p.returncode\n\nif REPO.exists(): shutil.rmtree(REPO)\nrun([\"git\",\"clone\",\"--depth\",\"1\",\"--branch\",\"develop/2.3\",\n     \"https://github.com/theiman112860/SynBioCrow.git\",str(REPO)],timeout=600)\n\n# Evidence evaluation needs optional thermodynamics support.\nrun([sys.executable,\"-m\",\"pip\",\"install\",\"-q\",\"-e\",str(REPO)+\"[doranet,thermo]\"],timeout=1800)\n\nPANEL=REPO/\"benchmarks/2.3/manuscript_panel_v2.json\"\n\n# Bounded lineage-aware state discovery. No exhaustive Drive crawl.\ncandidates=[\n    Path(\"/content/drive/MyDrive/SynBioCrow/benchmark/2.3/manuscript_panel_v2/state\"),\n    Path(\"/content/drive/MyDrive/SynBioCrow/benchmark/2.3/manuscript_panel_v2_general_completion/state\"),\n]\nSTATE=None\nfor c in candidates:\n    if c.is_dir() and any(c.iterdir()):\n        STATE=c\n        break\nif STATE is None:\n    base=Path(\"/content/drive/MyDrive/SynBioCrow/benchmark/2.3\")\n    for pat in (\"manuscript_panel_v2*/state\",\"*manuscript*panel*v2*/state\"):\n        hits=sorted(base.glob(pat))\n        for c in hits:\n            if c.is_dir() and any(c.iterdir()):\n                STATE=c; break\n        if STATE: break\nassert STATE is not None,\"Could not locate persisted manuscript-panel-v2 state tree in expected SynBioCrow benchmark directories\"\nprint(\"STATE_ROOT\",STATE)\n\nrun([sys.executable,str(REPO/\"scripts/run_dbtl_case_study_2_3.py\"),\n     \"--panel\",str(PANEL),\n     \"--state-root\",str(STATE),\n     \"--output-dir\",str(OUT),\n     \"--max-route-steps\",\"8\",\n     \"--max-routes\",\"100\",\n     \"--learn-route-limit\",\"20\"],cwd=REPO,timeout=3600,stream=True)\n\nbundle=OUT/\"SynBioCrow_2_3_DBTL_CASE_STUDY_RESULTS.zip\"\nwith zipfile.ZipFile(bundle,\"w\",zipfile.ZIP_DEFLATED) as z:\n    for p in sorted(OUT.glob(\"*.json\")): z.write(p,p.name)\n    z.write(REPO/\"scripts/run_dbtl_case_study_2_3.py\",\"run_dbtl_case_study_2_3.py\")\nprint(\"BUNDLE\",bundle)\nprint(\"SHA256\",hashlib.sha256(bundle.read_bytes()).hexdigest())\nfiles.download(str(bundle))\n"
   ]
